      "tags": ["Sonntagsessen", "Ofen"],
      "ingredients": [
        {"a": 1500, "u": "g", "n": "Roastbeef"},
        {"a": 2, "u": "EL", "n": "Senf"},
        {"a": 2, "u": "TL", "n": "Salz"},
        {"a": 150, "u": "g", "n": "Weizenmehl Type 405"},
        {"a": 3, "u": "Stk", "n": "Eier"},
        {"a": 250, "u": "ml", "n": "Milch"},
        {"a": 4, "u": "EL", "n": "Rinderfett oder Öl"},
        {"a": 400, "u": "ml", "n": "Rinderbrühe"}
