        {"a": 2, "u": "Stk", "n": "Zwiebeln"},
        {"a": 2, "u": "Stk", "n": "Möhren"},
        {"a": 2, "u": "EL", "n": "Tomatenmark"},
        {"a": 400, "u": "ml", "n": "Rinderbrühe"},
