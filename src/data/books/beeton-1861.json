    {
      "id": "beeton-roast-beef-yorkshire",
      "title": "Roast Beef mit Yorkshire Pudding",
      "chapter": "Beef",
      "cuisine": "Britisch",
      "category": "Hauptgericht",
      "meals": ["mittag"],
      "diet": [],
      "servings": 6,
