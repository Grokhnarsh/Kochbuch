    {
      "id": "glasse-onion-soup",
      "title": "Zwiebelsuppe nach englischer Art",
      "chapter": "Of Soops and Broths",
      "cuisine": "Britisch",
      "category": "Suppe",
      "meals": ["mittag", "abend"],
      "diet": ["vegetarisch"],
      "servings": 4,
      "prep": 15,
      "cook": 60,
      "difficulty": 1,
      "kcal": 320,
      "tags": ["günstig", "Winter"],
      "ingredients": [
        {"a": 1000, "u": "g", "n": "Zwiebeln"},
        {"a": 60, "u": "g", "n": "Butter"},
        {"a": 1.2, "u": "l", "n": "Gemüsebrühe"},
        {"a": 4, "u": "Scheibe", "n": "Weißbrot"},
